{
  "name": "testottest/yookassa-sdk-php",
  "description": "SDK for integration with YooKassa API.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://yookassa.ru/developers/api",
  "keywords": ["yoomoney", "yookassa", "payments", "api", "sdk"],
  "authors": [
    {
      "name": "YooMoney",
      "email": "cms@yoomoney.ru"
    }
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "ext-xml": "*",
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "YooKassa\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\YooKassa\\": "tests/"
    }
  }
}
